# Скопируйте в .env.local и заполните: cp .env.example .env.local && chmod 600 .env.local
# .env.local в git не попадает. Значения ниже — безопасные дефолты.
LOG_LEVEL=WARNING

# Ключи приложения: https://my.telegram.org/apps → API development tools.
# Одни ключи можно использовать на всю семью: у каждого своя сессия.
TG_API_ID=
TG_API_HASH=
# Строку сессии записывает `make login`, руками не заполнять
TG_SESSION=

# Боты, с которыми можно работать, через запятую без @. Пусто — любой бот, но только бот
TG_ALLOWED_BOTS=
# Чтение и поиск по чатам (tg_chats, tg_messages, tg_search). Выключено по умолчанию
TG_READ_ENABLED=false
# Чаты, закрытые для чтения: id из tg_chats или @username, через запятую
TG_READ_DENIED_CHATS=
